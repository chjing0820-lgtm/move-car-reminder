@echo off\nREM 挪车提醒 APP - 一键启动脚本（Windows）\nREM 使用方法: 双击运行或在命令行执行 deploy.bat\n\necho.\necho ================================\necho  挪车提醒 APP 一键部署\necho ================================\necho.\n\nREM 检查 Java\nwhere java >nul 2>nul\nif errorlevel 1 (\n    echo ❌ 错误: 未找到 Java\n    echo 请先安装 JDK 17 或更高版本\n    echo 下载地址: https://www.oracle.com/java/technologies/javase/jdk17-archive-downloads.html\n    pause\n    exit /b 1\n)\n\necho ✅ 检测到 Java\njava -version\necho.\n\nREM 检查 Android SDK\nif not defined ANDROID_HOME (\n    echo ⚠️  警告: 未设置 ANDROID_HOME 环境变量\n    echo 请先安装 Android Studio 并设置 ANDROID_HOME\n    echo.\n    set /p ANDROID_HOME=\"请输入 Android SDK 路径 (默认: C:\\\\Android\\\\sdk): \"\n    if \"!ANDROID_HOME!\"==\"\" (\n        set \"ANDROID_HOME=C:\\\\Android\\\\sdk\"\n    )\n)\n\necho ANDROID_HOME: %ANDROID_HOME%\necho.\n\nREM 检查 adb\nwhere adb >nul 2>nul\nif errorlevel 1 (\n    echo ❌ 错误: 未找到 adb\n    echo 请确保 Android SDK 已安装\n    pause\n    exit /b 1\n)\n\necho ✅ 检测到 ADB\necho.\n\nREM 检查设备\necho 🔍 检查手机连接...\nadb devices\necho.\n\nREM 获取设备数量\nfor /f %%a in ('adb devices ^| find /c \"device\"') do set device_count=%%a\n\nif %device_count% lss 2 (\n    echo ❌ 错误: 未检测到已连接的设备\n    echo 请确保:\n    echo   1. 手机已用 USB 线连接到电脑\n    echo   2. 手机已启用 USB 调试\n    echo   3. 已允许 USB 调试权限\n    pause\n    exit /b 1\n)\n\necho ✅ 检测到手机设备\necho.\n\nREM 开始编译\necho 🔨 正在编译项目...\necho.\ncall gradlew clean assembleDebug\n\nif errorlevel 1 (\n    echo ❌ 编译失败\n    pause\n    exit /b 1\n)\n\necho ✅ 编译成功\necho.\n\nREM 卸载旧版本\necho 🗑️  卸载旧版本应用...\nadb uninstall com.example.move_car_alert\necho.\n\nREM 安装新版本\necho 📱 安装应用到手机...\nadb install -r app\\build\\outputs\\apk\\debug\\app-debug.apk\n\nif errorlevel 1 (\n    echo ❌ 安装失败\n    pause\n    exit /b 1\n)\n\necho ✅ 安装成功\necho.\n\nREM 启动应用\necho 🚀 启动应用...\nadb shell am start -n com.example.move_car_alert/.MainActivity\n\necho ✅ 应用已启动\necho.\n\nREM 实时日志\necho 📋 显示实时日志 (按 Ctrl+C 停止)...\necho.\nadb logcat | findstr \"SmsReceiver\\|MoveCarAlarmService\\|move_car\"\n\npause\n"